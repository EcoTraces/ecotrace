{
  "name": "ecotrace-api",
  "private": true,
  "version": "1.0.0",
  "description": "Authenticated REST API for the EcoTrace platform",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node lib/server.js",
    "start:render": "npm run build && npm start",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore",
    "test": "vitest run src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
