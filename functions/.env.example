API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
# Render only: base64 encoding of the complete Firebase service-account JSON.
# Never commit the actual value. Cloud Functions does not require this variable.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=wastemanagementsystem-902eb
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: SMS/email delivery for notificationOutbox entries. Point these at
# a relay in front of whichever provider you choose (Twilio, SendGrid, a
# regional SMS gateway, etc.) that accepts POST {to, message} / {to, subject,
# body} with an Authorization: Bearer <API key> header. Without both a
# webhook URL and API key set, matching outbox entries are marked failed
# with a clear reason instead of silently staying queued forever.
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_WEBHOOK_URL=
EMAIL_PROVIDER_API_KEY=
